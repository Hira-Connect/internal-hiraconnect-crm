# Both values are safe to expose to the browser — row access is enforced by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Local only — never set this on Vercel and never prefix it NEXT_PUBLIC_.
# It bypasses RLS entirely. Used by `npm run setup:user` to create logins.
# Supabase dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
