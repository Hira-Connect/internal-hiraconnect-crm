# Supabase project: tcojgrxtpldiieytvthl (org akqbnjemvmmgfwyxgzwo)
# Both values are safe to expose to the browser — row access is enforced by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only — never prefix it NEXT_PUBLIC_. It bypasses RLS entirely.
# Needed by `npm run setup:user`, by Team → Invite a teammate, and by the
# "Forgot your password?" link. Without it those three features are disabled.
# Supabase dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Where the links in invitation and reset emails point. Set this in production so
# a preview deployment never emails anyone a link into the preview. Left unset,
# the app uses the origin of the request that triggered the email.
NEXT_PUBLIC_SITE_URL=https://internal-hiraconnect-crm.vercel.app

# ------------------------------------------------------- outgoing mail (Hostinger)
# Invitations and password resets are sent by this app, not by Supabase. With
# nothing set below, the account is still created and the one-time link is shown
# in the UI to pass on by hand — it just does not get emailed.
#
# Hostinger Email → hPanel → Emails → your mailbox → Configuration settings.
#   host  smtp.hostinger.com   (Titan-based plans use smtp.titan.email instead)
#   port  465 for SSL — the app switches to STARTTLS automatically if you use 587
#   user  the FULL mailbox address, not just the part before the @
#   pass  that mailbox's own password (create a dedicated mailbox, e.g. crm@)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=crm@hiraconnect.com
SMTP_PASS=the-mailbox-password

# From header. Hostinger refuses to send as an address you did not authenticate
# as, so leave this unset to use SMTP_USER, or set it to that same mailbox.
EMAIL_FROM=HIRA Connect <crm@hiraconnect.com>

# Check the credentials before anyone depends on them:
#   npm run mail:test -- --to you@hiraconnect.com

# Alternative transport — set this instead of SMTP_* to use Resend.
RESEND_API_KEY=
